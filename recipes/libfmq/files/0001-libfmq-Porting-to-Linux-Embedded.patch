From 459c0e24294c44be6b63330d057c90bba09a960c Mon Sep 17 00:00:00 2001
From: Angel Hitov <ahitov@codeaurora.org>
Date: Tue, 4 Jun 2019 11:39:53 +0300
Subject: [PATCH] libfmq: Porting to Linux Embedded

---
 CMakeLists.txt                       | 34 ++++++++++++++++++++++++++++
 EventFlag.cpp                        |  1 +
 FmqInternal.cpp                      | 12 ++++++++--
 benchmarks/msgq_benchmark_client.cpp |  2 +-
 include/fmq/MessageQueue.h           |  2 ++
 5 files changed, 48 insertions(+), 3 deletions(-)
 create mode 100644 CMakeLists.txt

diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..472937e
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,34 @@
+cmake_minimum_required(VERSION 3.3.1)
+project (libfmq)
+
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Werror")
+
+set (TARGET_NAME fmq)
+
+set (SOURCE_FILES
+    EventFlag.cpp
+    FmqInternal.cpp
+)
+
+add_library(${TARGET_NAME} SHARED ${SOURCE_FILES})
+
+target_link_libraries(${TARGET_NAME}
+    base
+    log
+    cutils
+    utils
+)
+
+target_include_directories(${TARGET_NAME} PRIVATE include)
+
+install(
+    TARGETS ${TARGET_NAME}
+    LIBRARY DESTINATION ${LIBFMQ_INSTALL_LIBDIR}
+    PERMISSIONS OWNER_EXECUTE OWNER_WRITE OWNER_READ
+                GROUP_EXECUTE GROUP_READ
+                WORLD_EXECUTE WORLD_READ
+)
+
+install(DIRECTORY include/fmq
+    DESTINATION include
+)
diff --git a/EventFlag.cpp b/EventFlag.cpp
index cb101bd..423701e 100644
--- a/EventFlag.cpp
+++ b/EventFlag.cpp
@@ -27,6 +27,7 @@
 #include <fmq/EventFlag.h>
 #include <utils/Log.h>
 #include <utils/SystemClock.h>
+#include <climits>

 namespace android {
 namespace hardware {
diff --git a/FmqInternal.cpp b/FmqInternal.cpp
index 6b95def..0bacff4 100644
--- a/FmqInternal.cpp
+++ b/FmqInternal.cpp
@@ -15,18 +15,26 @@
  */

 #define LOG_TAG "FMQ"
-#include <android-base/logging.h>
+#include <log/log.h>
+#include <string>

 namespace android {
 namespace hardware {
 namespace details {

+#ifndef CHECK
+#define CHECK(condition)   \
+  if (!(condition)) {      \
+    abort();               \
+  }
+#endif
+
 void check(bool exp) {
     CHECK(exp);
 }

 void logError(const std::string &message) {
-    LOG(ERROR) << message;
+    ALOGE(message.c_str());
 }

 }  // namespace details
diff --git a/benchmarks/msgq_benchmark_client.cpp b/benchmarks/msgq_benchmark_client.cpp
index 6abbe3b..9345e93 100644
--- a/benchmarks/msgq_benchmark_client.cpp
+++ b/benchmarks/msgq_benchmark_client.cpp
@@ -14,7 +14,7 @@
 * limitations under the License.
