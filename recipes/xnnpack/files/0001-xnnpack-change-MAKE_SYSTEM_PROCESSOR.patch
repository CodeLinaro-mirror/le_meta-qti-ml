From 0936e4bf85d956c8361cfc4fcc26671883757b09 Mon Sep 17 00:00:00 2001
From: Anton Dimitrov <antond@codeaurora.org>
Date: Wed, 13 May 2020 09:23:13 +0300
Subject: [PATCH] xnnpack: change MAKE_SYSTEM_PROCESSOR

---
 CMakeLists.txt | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 372d2f6..9d1338f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -14,11 +14,22 @@ INCLUDE(GNUInstallDirs)
 PROJECT(XNNPACK C CXX ASM)
 
 # ---[ Options.
-SET(XNNPACK_LIBRARY_TYPE "default" CACHE STRING "Type of library (shared, static, or default) to build")
+SET(XNNPACK_LIBRARY_TYPE "shared" CACHE STRING "Type of library (shared, static, or default) to build")
 SET_PROPERTY(CACHE XNNPACK_LIBRARY_TYPE PROPERTY STRINGS default static shared)
 OPTION(XNNPACK_ENABLE_ASSEMBLY "Build XNNPACK with assembly micro-kernels" ON)
-OPTION(XNNPACK_BUILD_TESTS "Build XNNPACK unit tests" ON)
-OPTION(XNNPACK_BUILD_BENCHMARKS "Build XNNPACK benchmarks" ON)
+OPTION(XNNPACK_BUILD_TESTS "Build XNNPACK unit tests" OFF)
+OPTION(XNNPACK_BUILD_BENCHMARKS "Build XNNPACK benchmarks" OFF)
+OPTION(XNNPACK_USE_SYSTEM_LIBS "Use system-provided dependency libraries" OFF)
+
+# ---[ Change Default system processor.
+IF("${CMAKE_SIZEOF_VOID_P}" STREQUAL "4")
+    SET(CMAKE_SYSTEM_PROCESSOR armv7)
+ENDIF()
+
+# ---[ Build independent code library.
+IF(NOT DEFINED CMAKE_POSITION_INDEPENDENT_CODE AND XNNPACK_LIBRARY_TYPE STREQUAL "shared")
+    SET(CMAKE_POSITION_INDEPENDENT_CODE ON)
+ENDIF()
 
 # ---[ CMake options
 IF(XNNPACK_BUILD_TESTS)
-- 
