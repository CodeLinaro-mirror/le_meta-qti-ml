From: Ivan Evlogiev <quic_ievlogie@quicinc.com>
Date: Wed, 26 Apr 2023 11:40:27 +0100
Subject: [PATCH 8/9] tensorflow-lite: Remove eigen/bench dir after fetching
 eigen

Signed-off-by: Ivan Evlogiev <quic_ievlogie@quicinc.com>

Change-Id: Ia953853fa3e7f934274e33528fc00345cb2731a3
---
 tensorflow/lite/tools/cmake/modules/eigen.cmake | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tensorflow/lite/tools/cmake/modules/eigen.cmake b/tensorflow/lite/tools/cmake/modules/eigen.cmake
index 6775ab8d3c4..0e6b61522e6 100644
--- a/tensorflow/lite/tools/cmake/modules/eigen.cmake
+++ b/tensorflow/lite/tools/cmake/modules/eigen.cmake
@@ -39,6 +39,10 @@ if(NOT eigen_POPULATED)
   OverridableFetchContent_Populate(eigen)
 endif()
 
+# Remove bench folder
+file(REMOVE_RECURSE ${eigen_SOURCE_DIR}/bench/)
+file(REMOVE_RECURSE ${eigen_BINARY_DIR}/bench/)
+
 # Patch Eigen to disable Fortran compiler check for BLAS and LAPACK tests.
 if(NOT EIGEN_DISABLED_FORTRAN_COMPILER_CHECK)
   file(WRITE "${eigen_SOURCE_DIR}/cmake/language_support.cmake" "
