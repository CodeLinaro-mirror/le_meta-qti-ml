From 72aeaf0542f7d81895519f69be2b712652a67f8e Mon Sep 17 00:00:00 2001
From: Dobromir Atanasov <quic_datanaso@quicinc.com>
Date: Mon, 30 May 2022 14:39:36 +0300
Subject: [PATCH 8/8] tensorflow-lite: Fix missing symbols needed by
 gst-plugins

- TfLiteXNNPackDelegateDelete symbol
- TfLiteGpuDelegateV2Delete symbol
- TfLiteHexagonDelegateCreate symbol
---
 tensorflow/lite/CMakeLists.txt   | 11 +++++++++++
 tensorflow/lite/c/CMakeLists.txt |  2 ++
 tensorflow/lite/c/dummy.cc       | 15 +++++++++++++++
 3 files changed, 28 insertions(+)
 create mode 100644 tensorflow/lite/c/dummy.cc

diff --git a/tensorflow/lite/CMakeLists.txt b/tensorflow/lite/CMakeLists.txt
index 97f46758fed..633499c5861 100644
--- a/tensorflow/lite/CMakeLists.txt
+++ b/tensorflow/lite/CMakeLists.txt
@@ -463,6 +463,15 @@ if(TFLITE_ENABLE_HEXAGON)
   )
 endif()
 
+list(APPEND TFLITE_DELEGATES_UTILS_SRCS
+  ${TFLITE_SOURCE_DIR}/delegates/utils/simple_delegate.h
+  ${TFLITE_SOURCE_DIR}/delegates/utils/simple_delegate.cc
+)
+
+add_library(utils_simple_delegate STATIC
+  ${TFLITE_DELEGATES_UTILS_SRCS}
+)
+
 if (TFLITE_ENABLE_RESOURCE)
   populate_tflite_source_vars("experimental/resource"
     TFLITE_EXPERIMENTAL_RESOURCE_SRCS
@@ -574,6 +583,8 @@ target_link_libraries(tensorflow-lite
     ${TFLITE_TARGET_DEPENDENCIES}
 )
 
+target_link_libraries(utils_simple_delegate tensorflow-lite)
+
 if (NOT BUILD_SHARED_LIBS)
   list(APPEND TFLITE_TARGET_PUBLIC_OPTIONS "-DTFL_STATIC_LIBRARY_BUILD")
 endif()
diff --git a/tensorflow/lite/c/CMakeLists.txt b/tensorflow/lite/c/CMakeLists.txt
index cf122a7a4fa..51d1345636e 100644
--- a/tensorflow/lite/c/CMakeLists.txt
+++ b/tensorflow/lite/c/CMakeLists.txt
@@ -84,6 +84,7 @@ add_library(tensorflowlite_c ${TFLITE_C_LIBTYPE}
   c_api_experimental.h
   c_api_experimental.cc
   c_api_internal.h
+  dummy.cc
 )
 
 if (TFLITE_C_BUILD_SHARED_LIBS)
@@ -99,6 +100,7 @@ endif()
 target_link_libraries(tensorflowlite_c
   tensorflow-lite
   rt
+  utils_simple_delegate
 )
 
 install(TARGETS tensorflowlite_c
diff --git a/tensorflow/lite/c/dummy.cc b/tensorflow/lite/c/dummy.cc
new file mode 100644
index 00000000000..2f7844fd3e4
--- /dev/null
+++ b/tensorflow/lite/c/dummy.cc
@@ -0,0 +1,15 @@
+#include <cstdio>
+
+#include "tensorflow/lite/delegates/xnnpack/xnnpack_delegate.h"
+#include "tensorflow/lite/delegates/gpu/delegate.h"
+#include "tensorflow/lite/delegates/hexagon/hexagon_delegate.h"
+#include "tensorflow/lite/tools/evaluation/utils.h"
+
+void dummy() {
+    char buf[64] = {0};
+    snprintf(buf, 64, "%p\n", TfLiteXNNPackDelegateDelete);
+#if TFLITE_SUPPORTS_GPU_DELEGATE
+    snprintf(buf, 64, "%p\n", TfLiteGpuDelegateV2Delete);
+#endif
+    snprintf(buf, 64, "%p\n", TfLiteHexagonDelegateCreate);
+}
-- 
