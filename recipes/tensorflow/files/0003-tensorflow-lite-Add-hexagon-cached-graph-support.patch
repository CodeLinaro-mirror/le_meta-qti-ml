+
+static const std::string kDumpPath = "/data/tf/";
+
+#define ALIGN8(x) (((x) + 7) & (~7ul))
+
+static const char kDummyBytes[7]{0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC};
+
+HexagonNNGraphStore::HexagonNNGraphStore(hexagon_nn_nn_id id)
+    : file_(std::ofstream(kDumpPath + "graph_" + std::to_string(id) +
+                          ".cache")) {}
+
+std::shared_ptr<HexagonNNGraphStore> HexagonNNGraphStore::New(
+    hexagon_nn_nn_id id) {
+  std::shared_ptr<HexagonNNGraphStore> sp(new HexagonNNGraphStore(id));
+  return sp;
+}
+
+HexagonNNGraphStore::~HexagonNNGraphStore() {}
+
+void HexagonNNGraphStore::AppendNode(
+    unsigned int node_id, unsigned int operation,
+    hexagon_nn_padding_type padding, const hexagon_nn_input* inputs,
+    int inputsLen, const hexagon_nn_output* outputs, int outputsLen) {
+  if (!file_.is_open()) {
+    HEX_NN_ERR << "Nodes output file is not opened";
+    return;
+  }
+
+  unsigned int input_size = sizeof(hexagon_nn_input);
+  unsigned int input_size_aligned = ALIGN8(input_size);
+  unsigned int output_size = sizeof(hexagon_nn_output);
+  unsigned int output_size_aligned = ALIGN8(output_size);
+
+  HexagonNNNode n{.op = 1,
+                  .packet_size = 0,
+                  .node_id = node_id,
+                  .operation = operation,
+                  .padding = padding,
+                  .inputsLen = inputsLen * input_size_aligned,
+                  .outputsLen = outputsLen * output_size_aligned};
+
+  unsigned int packet_const_size = sizeof(n);
+  unsigned int packet_const_size_aligned = ALIGN8(packet_const_size);
+
+  n.packet_size = packet_const_size_aligned + inputsLen * input_size_aligned +
+                  outputsLen * output_size_aligned;
+
+  unsigned int dummy_bytes = packet_const_size_aligned - packet_const_size;
+  file_.write(reinterpret_cast<const char*>(&n), packet_const_size);
+  if (dummy_bytes > 0) {
+    file_.write(kDummyBytes, dummy_bytes);
+  }
+
+  dummy_bytes = input_size_aligned - input_size;
+  for (int i = 0; i < inputsLen; i++) {
+    file_.write(reinterpret_cast<const char*>(&inputs[i]), input_size);
+    if (dummy_bytes > 0) {
+      file_.write(kDummyBytes, dummy_bytes);
+    }
+  }
+
+  dummy_bytes = output_size_aligned - output_size;
+  for (int i = 0; i < outputsLen; i++) {
+    file_.write(reinterpret_cast<const char*>(&outputs[i]), output_size);
+    if (dummy_bytes > 0) {
+      file_.write(kDummyBytes, dummy_bytes);
+    }
+  }
+}
+
+void HexagonNNGraphStore::AppendConstNode(
+    unsigned int node_id, unsigned int batches, unsigned int height,
+    unsigned int width, unsigned int depth, const unsigned char* data,
+    int dataLen) {
+  if (!file_.is_open()) {
+    HEX_NN_ERR << "Const output file is not opened";
+    return;
+  }
+
+  HexagonNNConstNode c{.op = 2,
+                       .packet_size = 0,
+                       .node_id = node_id,
+                       .batches = batches,
+                       .height = height,
+                       .width = width,
+                       .depth = depth,
+                       .dataLen = static_cast<unsigned int>(dataLen)};
+
+  unsigned int packet_const_size = sizeof(c);
+  unsigned int packet_const_size_aligned = ALIGN8(packet_const_size);
+  c.packet_size = packet_const_size_aligned + ALIGN8(dataLen);
+
+  unsigned int dummy_bytes = packet_const_size_aligned - packet_const_size;
+  file_.write(reinterpret_cast<const char*>(&c), packet_const_size);
+  if (dummy_bytes > 0) {
+    file_.write(kDummyBytes, dummy_bytes);
+  }
+
+  dummy_bytes = ALIGN8(dataLen) - dataLen;
+  file_.write(reinterpret_cast<const char*>(data), dataLen);
+  if (dummy_bytes > 0) {
+    file_.write(kDummyBytes, dummy_bytes);
+  }
+}
