+)
 
 set_target_properties(libhexagon_interface PROPERTIES PREFIX "")
 
@@ -505,6 +519,28 @@ target_compile_options(tensorflow-lite
   PUBLIC ${TFLITE_TARGET_PUBLIC_OPTIONS}
