+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER
+ * IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
+ * OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN
+ * IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ *
+ */
+
+#include <fstream>
+#include <vector>
+
+#include "bmp_helper.h"
+
+int ReadInputBMPFile(const std::string &input_bmp_name, uint32_t buf_height,
+        uint32_t buf_width, uint32_t buf_depth, const uint8_t* buf_data) {
+    std::ifstream bmp_file(input_bmp_name, std::ios::binary);
+    if (!bmp_file.is_open()) {
+        return -EACCES;
+    }
+    std::vector<uint8_t> bmp((std::istreambuf_iterator<char>(bmp_file)),
+            std::istreambuf_iterator<char>());
+
+    int32_t height = *(reinterpret_cast<int32_t*>(bmp.data() + 22));
+    int32_t width = *(reinterpret_cast<int32_t*>(bmp.data() + 18));
+    int32_t depth_bpp = *(reinterpret_cast<int32_t*>(bmp.data() + 28));
+    uint32_t depth = depth_bpp / 8;
+
+    if ((3 != depth) || (buf_depth != depth)) {
+        return -ENOTSUP;
+    }
+    if (buf_height != height) {
+        return -ENOTSUP;
+    }
+    if (buf_width != width) {
+        return -ENOTSUP;
+    }
+
+    uint32_t out_line_size = width * depth;
+    uint32_t in_line_size = (width * depth + 3) & (~3ul);
+    uint8_t* out = const_cast<uint8_t*>(buf_data);
+    int32_t header = *(reinterpret_cast<int32_t*>(bmp.data() + 10));
+    uint8_t* in = bmp.data() + header;
+    if (height > 0) {
+        in += in_line_size * (height - 1);
+    }
+
+    for (int h = 0; h < std::abs(height); h++) {
+        for (int w = 0; w < width; w++) {
+            int pos = w * depth;
+            out[pos + 0] = in[pos + 2];
+            out[pos + 1] = in[pos + 1];
+            out[pos + 2] = in[pos + 0];
+        }
+
+        if (height > 0) {
+           in -= in_line_size;
+        } else {
+           in += in_line_size;
+        }
+        out += out_line_size;
+    }
+
+    return 0;
+}
