+#include <fstream>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <sstream>
+
+#include "hexagon_nn_api_tracer.h"
+#include "hexagon_nn_graph_store.h"
+#include "tensorflow/lite/tools/logging.h"
+
+#ifdef HEXAGON_NN_API_TRACER_ENABLE_ENTRY_AND_EXIT_POINT_LOGS
+#define HEXAGON_NN_API_TRACER_ENTRY_LOG TFLITE_LOG(INFO) << __func__ << " enter"
+#define HEXAGON_NN_API_TRACER_EXIT_LOG TFLITE_LOG(INFO) << __func__ << " exit"
+#define HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc) \
+  TFLITE_LOG(INFO) << __func__ << " exit rc = " << rc
+#else
+#define HEXAGON_NN_API_TRACER_ENTRY_LOG
+#define HEXAGON_NN_API_TRACER_EXIT_LOG
+#define HEXAGON_NN_API_TRACER_EXIT_RC_LOG
+#endif
+
+namespace tflite {
+
+static const std::string kDumpPath = "/data/tf/";
+
+class HexagonNNAPITracer;
+static std::mutex g_mutex;
+static std::shared_ptr<HexagonNNAPITracer> g_this = nullptr;
+
+class HexagonNNAPITracer {
+ public:
+  HexagonNNAPITracer(HexagonNN& lib_hexagon_nn)
+      : lib_hexagon_nn_(lib_hexagon_nn) {}
+
+  static int hexagon_nn_config(void) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_config();
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_init(hexagon_nn_nn_id* g) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_init(g);
+
+    if (!rc) {
+      std::lock_guard<std::mutex> lock(g_this->mutex_hexagon_api_stores_);
+      g_this->hexagon_api_stores_[*g] = HexagonNNGraphStore::New(*g);
+    }
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_set_powersave_level(unsigned int level) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_set_powersave_level(level);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_set_debug_level(hexagon_nn_nn_id id, int level) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_set_debug_level(id, level);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_prepare(hexagon_nn_nn_id id) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_prepare(id);
+
+    if (!rc) {
+      std::lock_guard<std::mutex> lock(g_this->mutex_hexagon_api_stores_);
+      g_this->hexagon_api_stores_[id] = nullptr;
+    }
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_append_node(
+      hexagon_nn_nn_id id, unsigned int node_id, unsigned int operation,
+      hexagon_nn_padding_type padding, const hexagon_nn_input* inputs,
+      int inputsLen, const hexagon_nn_output* outputs, int outputsLen) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_append_node(
+        id, node_id, operation, padding, inputs, inputsLen, outputs,
+        outputsLen);
+
+    if (!rc) {
+      std::lock_guard<std::mutex> lock(g_this->mutex_hexagon_api_stores_);
+      g_this->hexagon_api_stores_[id]->AppendNode(
+          node_id, operation, padding, inputs, inputsLen, outputs, outputsLen);
+    }
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_append_const_node(
+      hexagon_nn_nn_id id, unsigned int node_id, unsigned int batches,
+      unsigned int height, unsigned int width, unsigned int depth,
+      const unsigned char* data, int dataLen) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_append_const_node(
+        id, node_id, batches, height, width, depth, data, dataLen);
+
+    if (!rc) {
+      std::lock_guard<std::mutex> lock(g_this->mutex_hexagon_api_stores_);
+      g_this->hexagon_api_stores_[id]->AppendConstNode(
+          node_id, batches, height, width, depth, data, dataLen);
+    }
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_execute(
+      hexagon_nn_nn_id id, unsigned int batches_in, unsigned int height_in,
+      unsigned int width_in, unsigned int depth_in,
+      const unsigned char* data_in, int data_inLen, unsigned int* batches_out,
+      unsigned int* height_out, unsigned int* width_out,
+      unsigned int* depth_out, unsigned char* data_out, int data_outLen,
+      unsigned int* data_len_out) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_execute(
+        id, batches_in, height_in, width_in, depth_in, data_in, data_inLen,
+        batches_out, height_out, width_out, depth_out, data_out, data_outLen,
+        data_len_out);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_execute_new(hexagon_nn_nn_id id,
+                                    const hexagon_nn_tensordef* inputs,
+                                    int inputsLen,
+                                    hexagon_nn_tensordef* outputs,
+                                    int outputsLen) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+#ifdef HEXAGON_NN_API_TRACER_INPUT_DUMP_ENABLE
+    for (int i = 0; i < inputsLen; i++) {
+      std::stringstream s;
+      s << kDumpPath << "input_" << i << "_" << inputs[i].batches << "_"
+        << inputs[i].height << "_" << inputs[i].width << "_" << inputs[i].depth
+        << ".data";
+      std::ofstream o(s.str());
+      o.write(reinterpret_cast<char*>(inputs[i].data),
+              inputs[i].data_valid_len);
+    }
+#endif
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_execute_new(
+        id, inputs, inputsLen, outputs, outputsLen);
+
+#ifdef HEXAGON_NN_API_TRACER_OUTPUT_DUMP_ENABLE
+    for (int i = 0; i < outputsLen; i++) {
+      std::stringstream s;
+      s << kDumpPath << "output_" << i << "_" << outputs[i].batches << "_"
+        << outputs[i].height << "_" << outputs[i].width << "_"
+        << outputs[i].depth << ".data";
+      std::ofstream o(s.str());
+      o.write(reinterpret_cast<char*>(outputs[i].data),
+              outputs[i].data_valid_len);
+    }
+#endif
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_teardown(hexagon_nn_nn_id id) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_teardown(id);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_snpprint(hexagon_nn_nn_id id, unsigned char* buf,
+                                 int bufLen) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_snpprint(id, buf, bufLen);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_getlog(hexagon_nn_nn_id id, unsigned char* buf,
+                               int bufLen) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_getlog(id, buf, bufLen);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_get_perfinfo(hexagon_nn_nn_id id,
+                                     hexagon_nn_perfinfo* info_out,
+                                     int info_outLen, unsigned int* n_items) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_get_perfinfo(
+        id, info_out, info_outLen, n_items);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_reset_perfinfo(hexagon_nn_nn_id id,
+                                       unsigned int event) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_reset_perfinfo(id, event);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_op_id_to_name(unsigned int node_id, char* name,
+                                      int nameLen) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_op_id_to_name(node_id, name,
+                                                              nameLen);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static void hexagon_nn_global_teardown(void) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    g_this->lib_hexagon_nn_.hexagon_nn_global_teardown();
+
+    HEXAGON_NN_API_TRACER_EXIT_LOG;
+  }
+
+  static void hexagon_nn_global_init(void) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    g_this->lib_hexagon_nn_.hexagon_nn_global_init();
+
+    HEXAGON_NN_API_TRACER_EXIT_LOG;
+  }
+
+  static bool hexagon_nn_is_device_supported() {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    bool rc = g_this->lib_hexagon_nn_.hexagon_nn_is_device_supported();
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_hexagon_interface_version(void) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_hexagon_interface_version();
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+  static int hexagon_nn_version(int* ver) {
+    HEXAGON_NN_API_TRACER_ENTRY_LOG;
+
+    int rc = g_this->lib_hexagon_nn_.hexagon_nn_version(ver);
+
+    HEXAGON_NN_API_TRACER_EXIT_RC_LOG(rc);
+
+    return rc;
+  }
+
+ private:
+  const HexagonNN lib_hexagon_nn_;
+  std::mutex mutex_hexagon_api_stores_;
+  std::map<hexagon_nn_nn_id, std::shared_ptr<HexagonNNGraphStore>>
+      hexagon_api_stores_;
+};
+
+const HexagonNN* CreateNewHexagonNNAPITracer(HexagonNN& lib_hexagon_nn) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  if (g_this == nullptr) {
+    g_this = std::make_shared<HexagonNNAPITracer>(lib_hexagon_nn);
+  }
+  static HexagonNN my_hexagon_nn{
+      .hexagon_nn_config = g_this->hexagon_nn_config,
+      .hexagon_nn_init = g_this->hexagon_nn_init,
+      .hexagon_nn_set_powersave_level = g_this->hexagon_nn_set_powersave_level,
+      .hexagon_nn_set_debug_level = g_this->hexagon_nn_set_debug_level,
+      .hexagon_nn_prepare = g_this->hexagon_nn_prepare,
+      .hexagon_nn_append_node = g_this->hexagon_nn_append_node,
+      .hexagon_nn_append_const_node = g_this->hexagon_nn_append_const_node,
+      .hexagon_nn_execute = g_this->hexagon_nn_execute,
+      .hexagon_nn_execute_new = g_this->hexagon_nn_execute_new,
+      .hexagon_nn_teardown = g_this->hexagon_nn_teardown,
+      .hexagon_nn_snpprint = g_this->hexagon_nn_snpprint,
+      .hexagon_nn_getlog = g_this->hexagon_nn_getlog,
+      .hexagon_nn_get_perfinfo = g_this->hexagon_nn_get_perfinfo,
+      .hexagon_nn_reset_perfinfo = g_this->hexagon_nn_reset_perfinfo,
+      .hexagon_nn_op_id_to_name = g_this->hexagon_nn_op_id_to_name,
+      .hexagon_nn_global_teardown = g_this->hexagon_nn_global_teardown,
+      .hexagon_nn_global_init = g_this->hexagon_nn_global_init,
+      .hexagon_nn_is_device_supported = g_this->hexagon_nn_is_device_supported,
+      .hexagon_nn_hexagon_interface_version =
+          g_this->hexagon_nn_hexagon_interface_version,
+      .hexagon_nn_version = g_this->hexagon_nn_version,
+  };
+
+  return &my_hexagon_nn;
+}
+
