+  if (TFLITE_ENABLE_HEXAGON_NN_API_TRACER_OUTPUT_DUMP)
+    list(APPEND
+      TFLITE_ENABLE_HEXAGON_NN_API_TRACER_COMPILE_DEFINITIONS
+      "-DHEXAGON_NN_API_TRACER_OUTPUT_DUMP_ENABLE"
+    )
+  endif()
+  if (TFLITE_ENABLE_HEXAGON_NN_API_TRACER_INPUT_DUMP)
