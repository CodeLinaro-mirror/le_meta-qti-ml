+
+std::shared_ptr<HexagonNNCachedGraph> HexagonNNCachedGraph::New(
+    const std::vector<uint8_t>& cached_graph) {
+  auto hexagon_nn_api = HexagonNNApi::New();
+
+  int ver;
+  int rc = hexagon_nn_api->hexagon_nn_version_(&ver);
+  if (0 != rc) {
+    HEX_NN_ERR << "hexagon_nn_version failed. Error: " << rc << std::endl;
+    return nullptr;
+  }
+
+  HEX_NN_MSG << "Using hexagon nn version 0x" << std::hex << ver << std::dec
+             << std::endl;
+
+  rc = hexagon_nn_api->hexagon_nn_config_();
+  if (0 != rc) {
+    HEX_NN_ERR << "hexagon_nn_config failed. Error: " << rc << std::endl;
+    return nullptr;
+  }
+
+  int id;
+  rc = hexagon_nn_api->hexagon_nn_init_(&id);
+  if (0 != rc) {
+    HEX_NN_ERR << "hexagon_nn_init failed. Error: " << rc << std::endl;
+    return nullptr;
+  }
+
+  rc = hexagon_nn_api->hexagon_nn_populate_graph_(id, cached_graph.data(),
+                                                  cached_graph.size());
+  if (0 != rc) {
+    HEX_NN_ERR << "hexagon_nn_populate_graph failed. Error: " << rc
+               << std::endl;
+    rc = hexagon_nn_api->hexagon_nn_teardown_(id);
+    if (0 != rc) {
+      HEX_NN_ERR << "hexagon_nn_teardown failed. Error: " << rc << std::endl;
+    }
+    return nullptr;
+  }
+
+  std::shared_ptr<HexagonNNCachedGraph> sp(
+      new HexagonNNCachedGraph(id, cached_graph, hexagon_nn_api));
+  return sp;
+}
+
+HexagonNNCachedGraph::HexagonNNCachedGraph(
+    int id, const std::vector<uint8_t>& cached_graph,
+    std::shared_ptr<const HexagonNNApi>& hexagon_nn_api)
+    : in_tensors_(ParseInputTensorDims(cached_graph)),
+      out_tensors_(ParseOutputTensorDims(cached_graph)),
+      id_(id),
+      hexagon_nn_api_(hexagon_nn_api) {}
+
+HexagonNNCachedGraph::~HexagonNNCachedGraph() {
+  int rc = hexagon_nn_api_->hexagon_nn_teardown_(id_);
+  if (0 != rc) {
+    HEX_NN_ERR << "hexagon_nn_teardown failed. Error: " << rc << std::endl;
+  }
+}
+
+std::vector<std::shared_ptr<const HexagonNNTensorDims>>
+HexagonNNCachedGraph::GetInputTensorDims() const {
+  return in_tensors_;
+}
+
+std::vector<std::shared_ptr<const HexagonNNTensorDims>>
+HexagonNNCachedGraph::GetOutputTensorDims() const {
+  return out_tensors_;
+}
+
+int HexagonNNCachedGraph::Process(
+    std::vector<std::shared_ptr<const HexagonNNTensor>>& in,
+    std::vector<std::shared_ptr<const HexagonNNTensor>>& out) const {
+  hexagon_nn_tensordef inputs[in.size()];
+  for (int i = 0; i < in.size(); i++) {
+    inputs[i] = in[i]->Export();
+  }
+
+  hexagon_nn_tensordef outputs[out.size()];
+  for (int i = 0; i < out.size(); i++) {
+    outputs[i] = out[i]->Export();
+  }
+
+  int rc = hexagon_nn_api_->hexagon_nn_execute_new_(id_, inputs, in.size(),
+                                                    outputs, out.size());
+  if (0 != rc) {
+    HEX_NN_ERR << "hexagon_nn_execute_new failed. Error: " << rc << std::endl;
+    return -ENOEXEC;
+  }
+
+  return 0;
+}
+
+std::vector<std::shared_ptr<const HexagonNNTensorDims>>
+HexagonNNCachedGraph::ParseInputTensorDims(
+    const std::vector<uint8_t>& cached_graph) const {
+  std::vector<std::shared_ptr<const HexagonNNTensorDims>> rc;
+
+  const uint8_t* p = cached_graph.data();
+  int size = cached_graph.size();
+
+  while (size > sizeof(HexagonNNNode)) {
+    const HexagonNNNode* n = reinterpret_cast<const HexagonNNNode*>(p);
+    if ((1 == n->op) && (OP_INPUT == n->operation)) {
+      int cnt_in = n->inputsLen / sizeof(hexagon_nn_input);
+      int cnt_out = n->outputsLen / sizeof(hexagon_nn_output);
+      const hexagon_nn_output* o = reinterpret_cast<const hexagon_nn_output*>(
+          p + sizeof(HexagonNNNode) + n->inputsLen);
+      for (int i = 0; i < cnt_out; i++, o++) {
+        rc.push_back(HexagonNNTensorDims::New(
+            o->max_sizes[0], o->rank > 1 ? o->max_sizes[1] : 1,
+            o->rank > 2 ? o->max_sizes[2] : 1,
+            o->rank > 3 ? o->max_sizes[3] : 1, o->elementsize));
+      }
+    }
+
+    p += n->packet_size;
+    size -= n->packet_size;
+  }
+
+  return rc;
+}
+
+std::vector<std::shared_ptr<const HexagonNNTensorDims>>
+HexagonNNCachedGraph::ParseOutputTensorDims(
+    const std::vector<uint8_t>& cached_graph) const {
+  std::vector<std::shared_ptr<const HexagonNNTensorDims>> rc;
+
+  const uint8_t* p = cached_graph.data();
+  int size = cached_graph.size();
+
+  std::vector<unsigned int> outputs;
+  std::vector<unsigned int> output_idxs;
+  while (size > sizeof(HexagonNNNode)) {
+    const HexagonNNNode* n = reinterpret_cast<const HexagonNNNode*>(p);
+    if ((1 == n->op) && (OP_OUTPUT == n->operation)) {
+      int cnt_in = n->inputsLen / sizeof(hexagon_nn_input);
+      const hexagon_nn_input* i =
+          reinterpret_cast<const hexagon_nn_input*>(p + sizeof(HexagonNNNode));
+      while (cnt_in-- > 0) {
+        outputs.push_back(i->src_id);
+        output_idxs.push_back(i->output_idx);
+        i++;
+      }
+    }
+
+    p += n->packet_size;
+    size -= n->packet_size;
+  }
+
+  p = cached_graph.data();
+  size = cached_graph.size();
+  while (size > sizeof(HexagonNNNode)) {
+    const HexagonNNNode* n = reinterpret_cast<const HexagonNNNode*>(p);
+    if (1 == n->op) {
+      for (int i = 0; i < outputs.size(); i++) {
+        if (outputs[i] == n->node_id) {
+          const hexagon_nn_output* o =
+              reinterpret_cast<const hexagon_nn_output*>(
+                  p + sizeof(HexagonNNNode) + n->inputsLen);
+          o += output_idxs[i];
+
+          rc.push_back(HexagonNNTensorDims::New(
+              o->max_sizes[0], o->rank > 1 ? o->max_sizes[1] : 1,
+              o->rank > 2 ? o->max_sizes[2] : 1,
+              o->rank > 3 ? o->max_sizes[3] : 1, o->elementsize));
+        }
+      }
+    }
+
+    p += n->packet_size;
+    size -= n->packet_size;
+  }
+
+  return rc;
+}
