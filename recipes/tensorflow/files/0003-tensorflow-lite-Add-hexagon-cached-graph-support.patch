+std::shared_ptr<const HexagonNNApi> HexagonNNApi::New() {
+  std::lock_guard<std::mutex> lock(HexagonNNApi::mtx_instance_);
+  if (instance_) {
+    return instance_;
+  }
+
+  void* lib_handle = dlopen("libhexagon_interface.so", RTLD_LAZY | RTLD_LOCAL);
+  if (lib_handle == nullptr) {
+    HEX_NN_ERR << "Failed to load libhexagon_interface.so : " << dlerror();
+    return nullptr;
+  }
+
+  hexagon_nn_version_fn* hexagon_nn_version =
+      reinterpret_cast<hexagon_nn_version_fn*>(
+          dlsym(lib_handle, "hexagon_nn_version"));
+  if (hexagon_nn_version == nullptr) {
+    HEX_NN_ERR << "Failed to load hexagon_nn_version : " << dlerror();
+    dlclose(lib_handle);
+    return nullptr;
+  }
+
+  hexagon_nn_config_fn* hexagon_nn_config =
+      reinterpret_cast<hexagon_nn_config_fn*>(
+          dlsym(lib_handle, "hexagon_nn_config"));
+  if (hexagon_nn_config == nullptr) {
+    HEX_NN_ERR << "Failed to load hexagon_nn_config : " << dlerror();
+    dlclose(lib_handle);
+    return nullptr;
+  }
+
+  hexagon_nn_init_fn* hexagon_nn_init = reinterpret_cast<hexagon_nn_init_fn*>(
+      dlsym(lib_handle, "hexagon_nn_init"));
+  if (hexagon_nn_init == nullptr) {
+    HEX_NN_ERR << "Failed to load hexagon_nn_init : " << dlerror();
+    dlclose(lib_handle);
+    return nullptr;
+  }
+
+  hexagon_nn_populate_graph_fn* hexagon_nn_populate_graph =
+      reinterpret_cast<hexagon_nn_populate_graph_fn*>(
+          dlsym(lib_handle, "hexagon_nn_populate_graph"));
+  if (hexagon_nn_populate_graph == nullptr) {
+    HEX_NN_ERR << "Failed to load hexagon_nn_populate_graph : " << dlerror();
+    dlclose(lib_handle);
+    return nullptr;
+  }
+
+  hexagon_nn_teardown_fn* hexagon_nn_teardown =
+      reinterpret_cast<hexagon_nn_teardown_fn*>(
+          dlsym(lib_handle, "hexagon_nn_teardown"));
+  if (hexagon_nn_teardown == nullptr) {
+    HEX_NN_ERR << "Failed to load hexagon_nn_teardown : " << dlerror();
+    dlclose(lib_handle);
+    return nullptr;
+  }
+
+  hexagon_nn_execute_new_fn* hexagon_nn_execute_new =
+      reinterpret_cast<hexagon_nn_execute_new_fn*>(
+          dlsym(lib_handle, "hexagon_nn_execute_new"));
+  if (hexagon_nn_execute_new == nullptr) {
+    HEX_NN_ERR << "Failed to load hexagon_nn_execute_new : " << dlerror();
+    dlclose(lib_handle);
+    return nullptr;
+  }
+
+  std::shared_ptr<HexagonNNApi> sp(new HexagonNNApi(
+      lib_handle, hexagon_nn_version, hexagon_nn_config, hexagon_nn_init,
+      hexagon_nn_populate_graph, hexagon_nn_teardown, hexagon_nn_execute_new));
+  return sp;
+}
