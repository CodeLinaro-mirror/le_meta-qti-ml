+
+#include <chrono>
+#include <fstream>
+#include <getopt.h>
+#include <vector>
+#include <string>
+
+#include "hexagon_nn_cached_graph.h"
+#include "hexagon_nn_tensor.h"
+#include "hexagon_nn_tensor_heap.h"
+#include "bmp_helper.h"
+#include "hexagon_nn_log.h"
+
+namespace run_cached_graph {
+
+struct Args {
+    std::string input_graph_name;
+    std::vector<std::string> input_file_names;
+    std::vector<std::string> output_file_names;
+};
+
+void DisplayUsage() {
+  HEX_NN_MSG
+      << "run_cached_graph\n"
+      << "--help, -h: application instructions\n"
+      << "--graph, -g: cached graph\n"
+      << "--input, -i: input bmp file\n"
+      << "--output, -o: output file\n";
+}
+
+int ArgsParse(int argc, char** argv, Args *args) {
+    while (true) {
+        static struct option long_options[] = {
+            {"help", optional_argument, nullptr, 'h'},
+            {"graph", required_argument, nullptr, 'g'},
+            {"input", required_argument, nullptr, 'i'},
+            {"output", required_argument, nullptr, 'o'},
+            {nullptr, 0, nullptr, 0}
+        };
+        int option_index = 0;
+        int c = getopt_long(argc, argv, "hg:i:o:", long_options, &option_index);
+        if (c == -1) {
+            break;
+        }
+
+        switch (c) {
+        case 'g':
+            args->input_graph_name = optarg;
+            break;
+        case 'i':
+            args->input_file_names.push_back(optarg);
+            break;
+        case 'o':
+            args->output_file_names.push_back(optarg);
+            break;
+        case 'h':
+        case '?':
+        default:
+            DisplayUsage();
+            return -EINVAL;
+        }
+    }
+
+    return 0;
+}
+
+int Main(int argc, char** argv) {
+    HEX_NN_MSG << "===== Run Cached Graph =====" << std::endl;
+
+    Args args;
+    int rc = ArgsParse(argc, argv, &args);
+    if (0 != rc) {
+        return rc;
+    }
+
+    std::ifstream graph_file(args.input_graph_name, std::ios::binary);
+    if (!graph_file.is_open()) {
+        HEX_NN_ERR << "Cannot open input file " << args.input_graph_name <<
+                std::endl;
+        return -EBADF;
+    }
+    std::vector<uint8_t> graph((std::istreambuf_iterator<char>(graph_file)),
+            std::istreambuf_iterator<char>());
+
+    auto b = std::chrono::system_clock::now();
+    auto g = HexagonNNCachedGraph::New(graph);
+    auto e = std::chrono::system_clock::now();
+    HEX_NN_MSG << "Load Graph time in microseconds: "
+        << std::chrono::duration_cast<std::chrono::microseconds>(e - b).count()
+        << " µs" << std::endl;
+    if (!g) {
+        return -EFAULT;
+    }
+
+    std::vector<std::shared_ptr<const HexagonNNTensorDims>> in_dims =
+            g->GetInputTensorDims();
+    if (in_dims.size() != args.input_file_names.size()) {
+        HEX_NN_ERR << "Number of input tensors " << in_dims.size() <<
+                " is different than number of input file names " <<
+                args.input_file_names.size() << std::endl;
+        return -EINVAL;
+    }
+
+    std::vector<std::shared_ptr<const HexagonNNTensor>> in;
+    for (auto &i : in_dims) {
+        in.push_back(HexagonNNTensorHeap::New(i));
+    }
+
+    for (size_t i = 0; i < args.input_file_names.size(); i++) {
+        rc = ReadInputBMPFile(args.input_file_names[i], in[i]->dims_->height_,
+                in[i]->dims_->width_, in[i]->dims_->depth_, in[i]->data_);
+        if (rc) {
+            return rc;
+        }
+    }
+
+    std::vector<std::shared_ptr<const HexagonNNTensorDims>> out_dims =
+            g->GetOutputTensorDims();
+    if (out_dims.size() != args.output_file_names.size()) {
+        HEX_NN_ERR << "Number of output tensors " << out_dims.size() <<
+                " is different than number of output file names " <<
+                args.output_file_names.size() << std::endl;
+        return -EINVAL;
+    }
+
+    std::vector<std::shared_ptr<const HexagonNNTensor>> out;
+    for (auto &o : out_dims) {
+        out.push_back(HexagonNNTensorHeap::New(o));
+    }
+
+    auto s = std::chrono::system_clock::now();
+    rc = g->Process(in, out);
+    auto f = std::chrono::system_clock::now();
+    HEX_NN_MSG << "Process time in microseconds: "
+        << std::chrono::duration_cast<std::chrono::microseconds>(f - s).count()
+        << " µs" << std::endl;
+    if (0 != rc) {
+        return rc;
+    }
+
+    for (int i = 0; i < out.size(); i++) {
+        std::ofstream f(args.output_file_names[i]);
+        if (!f.is_open()) {
+            HEX_NN_ERR << "Cannot open file for writing " <<
+                    args.output_file_names[i] << std::endl;
+            return -EACCES;
+        }
+        f.write(reinterpret_cast<const char *>(out[i]->data_),
+                out[i]->dims_->size_);
+    }
+
+    HEX_NN_MSG << "I am ready !!!" << std::endl;
+    return 0;
+}
+
+}  // namespace run_cached_graph
+
+int main(int argc, char** argv) {
+  return run_cached_graph::Main(argc, argv);
+}
