+  endif()
+  string (REPLACE ";" " " TFLITE_ENABLE_HEXAGON_NN_API_TRACER_COMPILE_DEFINITIONS "${TFLITE_ENABLE_HEXAGON_NN_API_TRACER_COMPILE_DEFINITIONS}")
+  target_compile_definitions(tensorflow-lite
+    PRIVATE
+    "${TFLITE_ENABLE_HEXAGON_NN_API_TRACER_COMPILE_DEFINITIONS}"
