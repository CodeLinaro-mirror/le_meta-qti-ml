Subject: [PATCH 08/14] tensorflow-lite: Add clang support

Change-Id: Iae22d67311234266d0e80929aec5525154a4a967
---
 tensorflow/lite/CMakeLists.txt                       | 12 +++++++++++-
 .../multimodel_label_image/multimodel_label_image.cc |  6 +++---
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/tensorflow/lite/CMakeLists.txt b/tensorflow/lite/CMakeLists.txt
index a6b85f7f3e9..ab4723e596e 100644
--- a/tensorflow/lite/CMakeLists.txt
+++ b/tensorflow/lite/CMakeLists.txt
@@ -44,8 +44,18 @@ if("${CMAKE_SYSTEM_NAME}" STREQUAL "Linux")
   add_definitions(-DBUILD_TESTING=OFF)
   add_definitions(-DEIGEN_MPL2_ONLY)
   add_definitions(-fPIC)
-  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fexceptions -fno-short-enums -Ofast -Wl,-ldl,-no-undefined")
+  set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,--no-undefined")
+  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fexceptions -fno-short-enums -Ofast")
   set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra")
+  if("${CMAKE_ASM_COMPILER}" STREQUAL "clang")
+    set(CMAKE_ASM_FLAGS "${CMAKE_ASM_FLAGS} -target aarch64-oe-linux")
+  endif()
+  if("${CMAKE_C_COMPILER}" STREQUAL "clang")
+    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -target aarch64-oe-linux")
+  endif()
+  if("${CMAKE_CXX_COMPILER}" STREQUAL "clang++")
+    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -target aarch64-oe-linux")
+  endif()
 endif()
 
 # Double colon in target name means ALIAS or IMPORTED target.
