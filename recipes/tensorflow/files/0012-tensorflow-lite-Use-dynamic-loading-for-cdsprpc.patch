Subject: [PATCH 12/14] tensorflow-lite: Use dynamic loading for cdsprpc

- Switch from dynamic linking to dynamic loading for libcdsprpc.so

Change-Id: Iefa2a85df02fc56e00041da65ad00494f64e9398
---
 tensorflow/lite/CMakeLists.txt                |  1 -
 .../delegates/hexagon/hexagon/hexagon_rpc.cc  | 91 +++++++++++++++++++
 2 files changed, 91 insertions(+), 1 deletion(-)
 create mode 100644 tensorflow/lite/delegates/hexagon/hexagon/hexagon_rpc.cc

diff --git a/tensorflow/lite/CMakeLists.txt b/tensorflow/lite/CMakeLists.txt
index d7d18db7a3d..2b226f57645 100644
--- a/tensorflow/lite/CMakeLists.txt
+++ b/tensorflow/lite/CMakeLists.txt
@@ -403,7 +403,6 @@ install(TARGETS libhexagon_interface
 add_dependencies(libhexagon_interface hexagon_nn_cached_graph)
 target_link_libraries(libhexagon_interface
   hexagon_nn_cached_graph
-  cdsprpc
 )
 
 list(APPEND TFLITE_TARGET_DEPENDENCIES
diff --git a/tensorflow/lite/delegates/hexagon/hexagon/hexagon_rpc.cc b/tensorflow/lite/delegates/hexagon/hexagon/hexagon_rpc.cc
new file mode 100644
index 00000000000..29a16823c86
--- /dev/null
+++ b/tensorflow/lite/delegates/hexagon/hexagon/hexagon_rpc.cc
@@ -0,0 +1,91 @@
