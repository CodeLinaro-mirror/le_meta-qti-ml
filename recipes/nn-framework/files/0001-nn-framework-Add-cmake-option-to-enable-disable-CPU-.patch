+#ifndef NN_INCLUDE_CPU_IMPLEMENTATION
+    LOG(ERROR) << "CPU implementation is disabled";
+    return ANEURALNETWORKS_UNAVAILABLE_DEVICE;
+#endif
+
     // b/109953668, disable OpenMP
 #ifdef NNAPI_OPENMP
     ScopedOpenmpSettings openMpSettings;
